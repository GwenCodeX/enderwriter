{
  "name": "dsh-enderwriter",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "EnderWriter 末影写作框架：把末影箱检索、伏笔巡检、六阶段写作接入会话，并提供末影箱可视化面板",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "engines": { "node": ">=18" },
  "keywords": ["dsh", "dsh-plugin", "novel", "writing", "memory", "llm"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
